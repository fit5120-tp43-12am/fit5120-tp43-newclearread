# Copy to production.env on the VM and fill only on the VM.
# Do not commit production.env.

CLEARREAD_AI_SERVICE_API_KEYS=replace-with-one-or-more-strong-random-keys
CLEARREAD_API_PORT=8010

SERVICE_NAME=clearread-ai-summary
SERVICE_VERSION=v1
PUBLIC_MODEL_NAME=clearread-llama32-3b-qlora-phase2-r32-a64-lr1p5e4-epoch4

VLLM_BASE_URL=http://vllm:8000
VLLM_MODEL=clearread-llama32-3b-qlora
VLLM_TIMEOUT_SECONDS=90
VLLM_MAX_CONCURRENCY=32
VLLM_MAX_TOKENS=260
VLLM_TEMPERATURE=0

MAX_BLOCKS=32
MAX_CHARS_PER_BLOCK=11000
REQUEST_BODY_LIMIT_BYTES=2097152
INCLUDE_ERROR_DETAILS=false
LOG_LEVEL=INFO
