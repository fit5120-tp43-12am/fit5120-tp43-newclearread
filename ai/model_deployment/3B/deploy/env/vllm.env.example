# Used by docker compose variable substitution.
# Keep secrets on the VM only.

HF_TOKEN=replace-if-base-model-access-needs-token
HF_CACHE_DIR=/opt/clearread-ai-summary/cache/huggingface
MODEL_ROOT=/opt/clearread-ai-summary/models
VLLM_BASE_IMAGE=vllm/vllm-openai:latest
VLLM_RUNTIME_IMAGE=clearread-vllm-openai-bnb:3b
VLLM_BASE_MODEL=unsloth/Llama-3.2-3B-Instruct-bnb-4bit
VLLM_BASE_SERVED_NAME=clearread-llama32-3b-base
VLLM_LORA_NAME=clearread-llama32-3b-qlora
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.86
VLLM_DTYPE=bfloat16
VLLM_LOGGING_LEVEL=INFO
