{
  "manifest_version": 3,
  "name": "Clearead",
  "description": "A local-first reading support foundation for the Clearead Chrome extension.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open Clearead"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "permissions": [
    "sidePanel"
  ]
}
