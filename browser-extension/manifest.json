{
  "manifest_version": 3,
  "name": "Clearead",
  "description": "A side panel reading support workflow for summarising pasted text and applying page reading tools with Clearead.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Clearead",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://clear-read-a3c2gyajcjf5agfd.australiaeast-01.azurewebsites.net/*"
  ]
}
