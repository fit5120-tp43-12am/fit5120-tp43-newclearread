{
  "manifest_version": 3,
  "name": "Clearead",
  "description": "A side panel reading support workflow for summarising pasted text with Clearead.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open Clearead"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://clear-read-a3c2gyajcjf5agfd.australiaeast-01.azurewebsites.net/*"
  ]
}
